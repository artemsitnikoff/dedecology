# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Backend intake endpoint (inside the compose network backend is `backend:8000`)
INTAKE_URL=http://backend:8000/api/v1/intake/max

# Shared secret — MUST equal the backend YANDEX_INTAKE_TOKEN
INTAKE_TOKEN=

# Max downloaded photo size in bytes (default 20 MiB)
MAX_PHOTO_BYTES=20971520

# Optional: group chat id for direct photo+caption intake (may be negative for supergroups).
# Empty → not pinned to a specific group (bot accepts from any group it is in, privacy off).
TELEGRAM_GROUP_CHAT_ID=
